<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS가 백그라운드 작업의 바탕화면 접근을 막아서 저장소는 ~/Developer 에 둔다.
     맥북이 켜져 있는 동안 매시 5분마다 GitHub 점검 리포트를 받아온다. 로그인할 때도 한 번 받는다.
     꺼져 있던 날의 리포트는 다음에 켜졌을 때 한꺼번에 들어온다. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zestoper.site-monitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/junyoungsmac/Developer/site-monitor/pull-report.sh</string>
    <string>--auto</string>
  </array>
  <!-- 매시 5분마다 실행. StartInterval 과 달리 잠자기 중에 놓친 시각은 깨어나자마자 한 번 실행된다 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>5</integer>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/junyoungsmac/Developer/site-monitor/pull.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/junyoungsmac/Developer/site-monitor/pull.log</string>
</dict>
</plist>
